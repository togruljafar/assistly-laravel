{
    "name": "assistly/laravel-channel",
    "description": "Route a Laravel application's own conversations through Assistly.",
    "type": "library",
    "license": "MIT",
    "require": {
        "illuminate/bus": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "php": "^8.2",
        "psr/http-message": "^1.1|^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "Assistly\\Channel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Assistly\\Channel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Assistly\\Channel\\AssistlyServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
